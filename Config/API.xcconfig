// API.xcconfig — tracked by git.
//
// Where the app looks for its backend. Nothing is set here on purpose: with
// no address configured the app falls back to the JSON bundled with it, so a
// fresh clone still runs offline in a Simulator and CI needs no local file.
//
// To point the app at a backend, create the ignored local override:
//
//   cp Config/API.local.xcconfig.example Config/API.local.xcconfig
//
// The address is split into a scheme and a host because "//" starts a comment
// in an xcconfig — a full URL written here would silently lose everything from
// the slashes onwards.

#include? "API.local.xcconfig"

API_SCHEME = $(LOCAL_API_SCHEME)
API_HOST = $(LOCAL_API_HOST)
